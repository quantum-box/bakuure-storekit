{
  "name": "@bakuure/storekit-core",
  "version": "0.1.0",
  "description": "Framework-agnostic TypeScript SDK for bakuure commerce API",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "keywords": [
    "bakuure",
    "commerce",
    "ecommerce",
    "sdk",
    "storefront"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/quantum-box/bakuure-storekit"
  }
}
